---
import { navigation } from "../data/navigation";

const year = new Date().getFullYear();
---
<footer>
  <a class="footer-brand" href="/#inizio" aria-label="FisioSalute, torna alla pagina iniziale">
    <img src="/brand/FisioSalute_logo-1.png" alt="FisioSalute di Erika Voltan" width="499" height="291" />
  </a>
  <p>Fisioterapia e riabilitazione<br />su appuntamento.</p>
  <nav aria-label="Navigazione a piè di pagina">
    {navigation.map(({ label, href }) => <a href={href}>{label}</a>)}
  </nav>
  <small>© {year} FisioSalute di Erika Voltan. Tutti i diritti riservati.</small>
</footer>
