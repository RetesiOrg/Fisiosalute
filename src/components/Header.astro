---
import { navigation } from "../data/navigation";
const professionals = navigation.filter(({ label }) => ["Erika Voltan", "Fisioterapisti", "Medici specialisti"].includes(label));
const mainNavigation = navigation.filter(({ label }) => !["Erika Voltan", "Fisioterapisti", "Medici specialisti"].includes(label));
---
<header class="site-header">
  <a class="brand" href="/#inizio" aria-label="FisioSalute, torna alla pagina iniziale">
    <img src="/brand/FisioSalute_logo-1.webp" alt="FisioSalute di Erika Voltan" width="190" height="111" />
  </a>
  <nav aria-label="Navigazione principale">
    <div class="nav-dropdown">
      <span class="nav-dropdown-trigger" tabindex="0">Professionisti <span aria-hidden="true">⌄</span></span>
      <div>{professionals.map(({ label, href }) => <a href={href}>{label}</a>)}</div>
    </div>
    {mainNavigation.map((item) => <a href={item.href} target={"external" in item && item.external ? "_blank" : undefined} rel={"external" in item && item.external ? "noreferrer" : undefined}>{item.label}{"external" in item && item.external ? " ↗" : ""}</a>)}
  </nav>
  <a class="button button-small" href="/#contatti">Richiedi un appuntamento</a>
  <details class="mobile-menu">
    <summary><span>Menu</span><i aria-hidden="true"></i></summary>
    <nav aria-label="Navigazione mobile">
      {navigation.map((item) => <a href={item.href} target={"external" in item && item.external ? "_blank" : undefined} rel={"external" in item && item.external ? "noreferrer" : undefined}>{item.label}{"external" in item && item.external ? " ↗" : ""}</a>)}
    </nav>
  </details>
</header>
