---
import { navigation } from "../data/navigation";
const professionals = navigation.slice(0, 1).concat(navigation.slice(2, 4));
const mainNavigation = [navigation[1], ...navigation.slice(4)];
---
<header class="site-header">
  <a class="brand" href="/#inizio" aria-label="FisioSalute, torna alla pagina iniziale">
    <img src="/brand/FisioSalute_logo-1.png" alt="FisioSalute di Erika Voltan" width="190" height="111" />
  </a>
  <nav aria-label="Navigazione principale">
    <div class="nav-dropdown">
      <span class="nav-dropdown-trigger" tabindex="0">Professionisti <span aria-hidden="true">⌄</span></span>
      <div>{professionals.map(({ label, href }) => <a href={href}>{label}</a>)}</div>
    </div>
    {mainNavigation.map(({ label, href }) => <a href={href}>{label}</a>)}
  </nav>
  <a class="button button-small" href="/#contatti">Richiedi un appuntamento</a>
  <details class="mobile-menu">
    <summary><span>Menu</span><i aria-hidden="true"></i></summary>
    <nav aria-label="Navigazione mobile">
      {navigation.map(({ label, href }) => <a href={href}>{label}</a>)}
    </nav>
  </details>
</header>
