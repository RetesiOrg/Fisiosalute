---
import type { HTMLAttributes } from "astro/types";
import metadata from "../data/image-metadata.json";
type Props = HTMLAttributes<"img"> & { src: string; alt: string };
const { src, alt, sizes = "(max-width: 900px) calc(100vw - 48px), 45vw", loading, fetchpriority, width, height, srcset, decoding = "async", ...attributes } = Astro.props;
const info = (metadata as Record<string, { width: number; height: number; srcset: string | null }>)[src];
const imageSrcset = info?.srcset ?? srcset;
---
<img {...attributes} src={src} alt={alt} width={info?.width ?? width} height={info?.height ?? height} srcset={imageSrcset} sizes={imageSrcset ? sizes : undefined} loading={loading ?? (fetchpriority === "high" ? "eager" : "lazy")} fetchpriority={fetchpriority} decoding={decoding} />
