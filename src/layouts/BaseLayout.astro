---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
}

const {
  keywords = [],
  title = "FisioSalute di Erika Voltan | Fisioterapia e Riabilitazione",
  description = "FisioSalute di Erika Voltan: fisioterapia, terapia manuale, riabilitazione e prevenzione con percorsi personalizzati.",
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname === "/" || /\.[a-z0-9]+$/i.test(pathname) ? pathname : `${pathname.replace(/\/$/, "")}/`, "https://www.fisiosalute.it").href;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#164c4a" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main-content">Salta al contenuto</a><slot /><a class="whatsapp-button" href="https://wa.me/393494011847" target="_blank" rel="noreferrer" aria-label="Scrivi a FisioSalute su WhatsApp"><span aria-hidden="true">WhatsApp</span></a><CookieConsent /></body>
</html>
