---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const partners = [
  { name: "ALOMAR", label: "Convenzione", description: "Convenzione dedicata agli associati dell’Associazione Lombarda Malati Reumatici per rendere più accessibile la fisioterapia specialistica.", href: "/servizi/area/fisioterapia-riabilitazione", className: "alomar" },
  { name: "Rete medico-specialistica", label: "Specialisti", description: "Specialisti che collaborano con i fisioterapisti nel rispetto dei ruoli professionali e della riservatezza prevista dalle strutture di appartenenza.", href: "/equipe-medica", className: "medical-network" },
  { name: "Strutture riabilitative", label: "Strutture", description: "Collaborazioni sul territorio per integrare servizi specifici, tra cui l’idrokinesiterapia in piscina riabilitativa con acqua calda.", href: "/servizi", className: "rehab-structures" },
  { name: "Self Defense Sondrio ASD", label: "Self Defense", description: "Corsi di difesa personale, consapevolezza e preparazione a Sondrio e Morbegno.", href: "https://www.selfdefensesondrio.it", className: "self-defense" },
  { name: "Ortopedia Medisan", label: "MEDISAN", description: "Ortopedia e supporto specializzato per le esigenze della persona.", href: "https://www.facebook.com/p/Ortopedia-Medisan-100063492822762/", className: "medisan" },
];
---

<BaseLayout title="Collaborazioni | FisioSalute Sondrio" description="Le collaborazioni di FisioSalute con realtà e professionisti del territorio.">
  <main>
    <Header />
    <section class="collab-hero"><p class="eyebrow light">Una rete intorno alla persona</p><h1>Collaborazioni.</h1><p>Professionisti e realtà del territorio con cui condividiamo attenzione, competenza e cura per il benessere.</p></section>
    <section class="collab-directory" aria-labelledby="collab-title"><p class="eyebrow">Collaborazioni</p><h2 id="collab-title">I nostri partner.</h2><div class="collab-grid">
      {partners.map((partner) => <a class:list={["collab-card", partner.className]} href={partner.href} target={partner.href.startsWith("http") ? "_blank" : undefined} rel={partner.href.startsWith("http") ? "noreferrer" : undefined}><div class="partner-logo">{partner.className === "self-defense" ? <img src="https://www.selfdefensesondrio.it/images/logo.webp" alt={`Logo ${partner.name}`} /> : partner.className === "medisan" ? <img src="/brand/ortopedia-medisan.svg" alt={`Logo ${partner.name}`} /> : <span>{partner.label}</span>}</div><div><h3>{partner.name}</h3><p>{partner.description}</p><span class="collab-link">Visita il sito o la pagina <span aria-hidden="true">↗</span></span></div></a>)}
    </div></section>
    <Footer />
  </main>
</BaseLayout>

<style>
.collab-hero{padding:120px clamp(24px,8vw,128px);background:var(--deep);color:#fff}.collab-hero h1{margin:0 0 24px;font-size:clamp(48px,6vw,82px);line-height:1.02}.collab-hero>p:last-child{max-width:650px;color:#d5e1de;font-size:19px}.collab-directory{padding:110px 0 110px clamp(24px,8vw,128px);background:var(--ivory);overflow:hidden}.collab-directory h2{margin:0 0 55px;color:var(--deep);font-size:clamp(38px,4.5vw,62px)}.collab-grid{display:flex;gap:24px;overflow-x:auto;padding:0 clamp(24px,8vw,128px) 24px 0;scroll-snap-type:x proximity;scrollbar-width:thin}.collab-card{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:center;flex:0 0 min(680px,82vw);scroll-snap-align:start;padding:35px;background:#fff;color:inherit;text-decoration:none;border:1px solid #dce3de;transition:transform .2s ease,box-shadow .2s ease}.collab-card:hover{transform:translateY(-4px);box-shadow:0 16px 35px #164c7414}.partner-logo{height:150px;display:grid;place-items:center;text-align:center;border-radius:4px;overflow:hidden;color:var(--petrol);font-weight:700}.partner-logo img{display:block;width:100%;height:100%;object-fit:contain}.collab-card h3{margin:0 0 12px;color:var(--deep);font-size:25px}.collab-card p{color:#56635f;line-height:1.5}.collab-link{display:block;margin-top:22px;color:var(--petrol);font:600 12px "Montserrat"}@media(max-width:800px){.collab-card{grid-template-columns:120px 1fr;gap:20px;padding:22px}.partner-logo{height:120px}.collab-card h3{font-size:21px}}
</style>
