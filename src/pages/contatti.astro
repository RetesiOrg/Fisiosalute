---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const mapsUrl = "https://www.google.com/maps/place//data=!4m2!3m1!1s0x47838fff424efac1:0x985d407e41cfd44a?sa=X&ved=1t:8290&ictx=111";
---
<BaseLayout title="Contatti e dove siamo | FisioSalute" description="Contatti, orari e indicazioni per raggiungere FisioSalute a Sondrio."><main><Header /><section class="page-hero"><p class="eyebrow light">FisioSalute a Sondrio</p><h1>Contatti e dove siamo.</h1><p>Scrivici, chiamaci o vieni a trovarci: ti aiuteremo a individuare il percorso più adatto.</p></section><section class="contact-location"><div class="contact-details"><p class="eyebrow">Contatti</p><h2>Parliamone.</h2><p><strong>Telefono e WhatsApp</strong><br /><a href="tel:+393494011847">349 4011847</a></p><p><strong>E-mail</strong><br /><a href="mailto:info@fisiosalute.it">info@fisiosalute.it</a></p><p><strong>Orari</strong><br />Lunedì–venerdì · 8:00–20:30<br />Sabato · 8:00–13:00, previo appuntamento</p><a class="button" href="mailto:info@fisiosalute.it">Scrivici una e-mail</a></div><div class="location-map"><iframe src="https://www.google.com/maps?q=Via%20Brigata%20Alpina%20Orobica%2041%2FC%2C%2023100%20Sondrio%20SO&output=embed" title="Mappa di FisioSalute a Sondrio" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><address><strong>Indirizzo</strong>Via Brigata Alpina Orobica, 41/C<br />23100 Sondrio SO<br /><a href={mapsUrl} target="_blank" rel="noreferrer">Apri in Google Maps →</a></address></div></section><Footer /></main></BaseLayout>
<style>.contact-location{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;padding:110px clamp(24px,8vw,128px);background:var(--ivory)}.contact-details h2{margin:0 0 30px;color:var(--deep);font-size:clamp(38px,4.5vw,62px)}.contact-details p{color:#56635f;line-height:1.6}.contact-details strong{color:var(--deep)}.contact-details .button{margin-top:15px}.location-map iframe{display:block;width:100%;height:420px;border:0}.location-map address{padding:24px;background:#fff;color:#56635f;font-style:normal;line-height:1.7}.location-map address strong{display:block;color:var(--deep)}@media(max-width:800px){.contact-location{grid-template-columns:1fr;gap:40px;padding:75px 24px}.location-map iframe{height:330px}}</style>
