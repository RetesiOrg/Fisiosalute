---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const specialties = [
  ["Fisiatria", "Per l’inquadramento dei disturbi muscoloscheletrici e la definizione del progetto riabilitativo.", "/servizi/area/fisiatria"],
  ["Ortopedia", "Per patologie articolari, indicazioni infiltrative e percorsi prima o dopo un intervento.", "/servizi/area/ortopedia"],
  ["Terapie infiltrative", "Prestazioni eseguite dallo specialista quando indicate nel percorso clinico.", "/servizi/terapie-infiltrative"],
  ["Otorinolaringoiatria", "Per disturbi di orecchio, naso e gola e per l’inquadramento di vertigini e alterazioni dell’equilibrio.", "/servizi/area/otorinolaringoiatria"],
  ["Nutrizione e dieta", "Visite dietistiche e percorsi nutrizionali personalizzati a supporto degli obiettivi di salute.", "/servizi/area/nutrizione-dieta"],
];
---
<BaseLayout title="Medici specialisti | FisioSalute Sondrio" description="I medici specialisti che collaborano con i fisioterapisti di FisioSalute a Sondrio."><main><Header /><section class="page-hero medical-hero"><p class="eyebrow light">Competenze che lavorano insieme</p><h1>I medici specialisti.</h1><p>Gli specialisti affiancano il lavoro fisioterapico quando una valutazione medica può rendere la presa in carico più completa.</p></section><section class="section medical-intro"><div><p class="eyebrow">Il modello FisioSalute</p><h2>Un unico staff<br />intorno al paziente.</h2></div><p>Fisioterapisti e medici condividono obiettivi e progressi nel rispetto dei rispettivi ruoli professionali. Così ogni passaggio del percorso resta comprensibile e coordinato.</p></section><section class="specialty-grid">{specialties.map(([title,copy,href],i) => <article><span>0{i+1}</span><h2>{title}</h2><p>{copy}</p><a href={href}>Approfondisci l’area →</a></article>)}</section><section class="staff-cta"><div><p class="eyebrow light">Informazioni e disponibilità</p><h2>Trova lo specialista più adatto.</h2></div><div><p>I profili autorizzati saranno completati con fotografia, formazione e curriculum. Per i medici che operano in strutture AST, nomi e immagini non vengono pubblicati: la segreteria fornisce direttamente le informazioni disponibili.</p><a class="button button-sand" href="/#contatti">Richiedi informazioni</a></div></section><Footer /></main></BaseLayout>
