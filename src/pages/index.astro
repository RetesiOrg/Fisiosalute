---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const services = [
  ["fisioterapia", "Fisioterapia e riabilitazione", "Valutazione, terapia manuale ed esercizio per recuperare movimento, autonomia e fiducia."],
  ["prevenzione", "Ortopedia e fisiatria", "Valutazioni specialistiche, terapie infiltrative e confronto con il team riabilitativo."],
  ["terapia-manuale", "Terapie fisiche", "Laserterapia e tecarterapia inserite nel percorso quando clinicamente appropriate."],
  ["postura", "Nutrizione", "Visite dietistiche e percorsi nutrizionali personalizzati a supporto della salute."],
  ["riabilitazione", "Otorinolaringoiatria", "Valutazioni specialistiche per disturbi di orecchio, naso e gola, integrate quando utile nel percorso di cura."],
  ["domicilio", "Pilates e rieducazione posturale", "Percorsi individuali per migliorare postura, controllo del movimento, forza e consapevolezza corporea."],
];
const faqs = [
  ["Come si svolge la prima visita?", "La prima seduta è dedicata all’ascolto, alla valutazione del movimento e alla definizione condivisa degli obiettivi. Da qui nasce un percorso realmente personale."],
  ["Quanto dura una seduta?", "La durata dipende dal tipo di trattamento e dalle esigenze della persona. Verrà indicata con chiarezza al momento della prenotazione."],
  ["Serve una prescrizione medica?", "Non sempre. In presenza di diagnosi, esami o indicazioni specialistiche è comunque utile portarli alla prima visita."],
  ["È possibile richiedere una visita a domicilio?", "Sì, in base alla zona e alla disponibilità. Indicalo nella richiesta di appuntamento."],
];
const studioHighlights = [
  ["erika-voltan.png", "Erika Voltan", "Fisioterapista e fondatrice di FisioSalute", "/erika-voltan"],
  ["staff-fisiosalute.png", "Fisioterapisti", "Competenze diverse, una visione condivisa", "/staff"],
  ["collaborazioni-fisiosalute.png", "Medici specialisti", "Specialisti al fianco del percorso riabilitativo", "/equipe-medica"],
  ["laserterapia.jpeg", "Servizi", "Tutte le aree di cura e prevenzione", "/servizi"],
];
---
<BaseLayout title="FisioSalute | Poliambulatorio multidisciplinare a Sondrio" description="FisioSalute è un poliambulatorio multidisciplinare a Sondrio per fisioterapia, riabilitazione, ortopedia, fisiatria e nutrizione."><main><Header />
  <section class="hero" id="inizio"><picture class="hero-media"><source media="(max-width: 900px)" srcset="/images/studio-fisiosalute-mobile.webp" /><img src="/images/studio-fisiosalute.webp" alt="Palestra riabilitativa del poliambulatorio FisioSalute" width="1920" height="900" fetchpriority="high" /></picture><div class="hero-overlay"></div><div class="hero-content"><p class="eyebrow light">Poliambulatorio multidisciplinare · Fisioterapia e medicina · Sondrio</p><h1>Il tuo percorso,<br />dall’inizio alla fine.</h1><p class="hero-copy"><strong>La tua salute, al centro della nostra attenzione.</strong> Ci prendiamo cura di te a 360°, con un approccio personalizzato che parte dalle tue esigenze e integra competenze fisioterapiche e mediche per costruire insieme il percorso di cura più adatto a te.</p><div class="hero-actions"><a class="button button-sand" href="#contatti">Richiedi un appuntamento</a><a class="text-link light" href="/servizi">Scopri i servizi <span>→</span></a></div></div><div class="hero-note"><strong>FisioSalute</strong><span>di Erika Voltan</span><span>Un’unica équipe intorno a te</span></div></section>
  <section class="trust-strip" aria-label="Valori del centro"><div><span>01</span><p><strong>Ascolto</strong>Prima di tutto, la tua storia.</p></div><div><span>02</span><p><strong>Equipe</strong>Professionisti che si confrontano.</p></div><div><span>03</span><p><strong>Continuità</strong>Con te lungo tutto il percorso.</p></div></section>
  <section class="section services" id="servizi"><div class="section-heading"><div><p class="eyebrow">Ci prendiamo cura di te</p><h2>La fisioterapia<br />al centro.</h2></div><p>La fisioterapia resta il cuore di FisioSalute, ma il percorso di cura non si ferma qui. Quando necessario, integriamo competenze mediche e professionali diverse per offrirti una presa in carico completa, coordinata e costruita sulle tue esigenze.</p></div><div class="service-grid service-grid-six">{services.map(([icon,title,copy], i) => <article class="service-card"><span class="service-number">0{i+1}</span><img src={`/icons/${icon}.png`} alt="" width="54" height="54" loading="lazy" /><h3>{title}</h3><p>{copy}</p><a href="/servizi">Esplora l’area <span>→</span></a></article>)}</div></section>
  <section class="mission-strip" id="approccio"><div class="mission-image"><img src="/images/valutazione.webp" alt="Valutazione fisioterapica del movimento" loading="lazy" /></div><div class="mission-copy"><p class="eyebrow light">La missione FisioSalute</p><h2>Lavoriamo come una squadra per il tuo recupero.</h2><p>Mettiamo la persona al centro e coordiniamo competenze fisioterapiche e mediche. Condividiamo obiettivi, progressi e scelte per accompagnarti con continuità lungo tutto il percorso.</p><div class="team-flow" aria-label="La persona, i fisioterapisti e i medici specialisti collaborano verso il recupero"><span>Tu</span><i aria-hidden="true">→</i><span>Fisioterapisti</span><i aria-hidden="true">↔</i><span>Medici specialisti</span><i aria-hidden="true">→</i><strong>Il tuo recupero</strong></div></div></section>
  <section class="section about" id="studio"><div class="about-copy"><p class="eyebrow">La professionista</p><h2>Erika Voltan,<br />fisioterapista.</h2><p class="lead">Un approccio attento, chiaro e vicino alla persona.</p><p>Credo in una fisioterapia che renda la persona parte attiva del proprio recupero. Ogni percorso nasce dall’ascolto e unisce trattamento, movimento ed educazione, con spiegazioni semplici e obiettivi realistici.</p><blockquote>“Il mio obiettivo non è soltanto farti stare meglio oggi, ma darti gli strumenti per muoverti con più fiducia domani.”</blockquote><a class="text-link" href="/erika-voltan">Conosci Erika e il suo percorso <span>→</span></a></div><div class="about-gallery"><div class="photo photo-main"><img src="/images/riabilitazione.webp" alt="Esercizio riabilitativo personalizzato" width="800" height="800" loading="lazy" decoding="async" /></div><div class="photo photo-small photo-portrait"><img src="/images/erika-voltan.png" alt="Erika Voltan, fisioterapista" width="140" height="140" decoding="async" /></div><div class="quality-stamp"><span>Fisio</span><strong>Salute</strong><small>movimento & benessere</small></div></div></section>
  <section class="studio-highlights" aria-labelledby="studio-highlights-title"><div class="studio-highlights-heading"><p class="eyebrow light">Una squadra al tuo fianco</p><h2 id="studio-highlights-title">Conosci FisioSalute.</h2><p>Scopri le persone, le competenze e i servizi che mettiamo al tuo fianco per prenderci cura della tua salute a 360°.</p></div><div class="studio-highlights-grid">{studioHighlights.map(([image, title, copy, href]) => <a class="studio-highlight-link" href={href} aria-label={`Scopri ${title}`}><img src={`/images/${image}`} alt="" width="140" height="140" decoding="async" /><div><h3>{title}</h3><p>{copy}</p></div><span aria-hidden="true">→</span></a>)}</div></section>
  <section class="section clinic-overview"><div><p class="eyebrow">Il poliambulatorio</p><h2>Spazi e competenze pensati intorno a te.</h2><p>FisioSalute dispone di reception, sale d’attesa, studi medici e fisioterapici e due palestre riabilitative attrezzate. Gli ambienti sono accessibili, privi di barriere architettoniche e organizzati per offrire comfort, riservatezza e sicurezza.</p><a class="text-link" href="/informazioni-paziente">Informazioni utili <span>→</span></a></div><div class="clinic-values"><p class="eyebrow">I nostri valori</p><ul><li><strong>Centralità della persona</strong><span>Ascolto e percorsi personalizzati.</span></li><li><strong>Professionalità</strong><span>Competenze e aggiornamento continuo ECM.</span></li><li><strong>Collaborazione</strong><span>Un’équipe che condivide obiettivi e progressi.</span></li><li><strong>Responsabilità</strong><span>Trasparenza, appropriatezza e sicurezza.</span></li><li><strong>Rispetto e qualità</strong><span>Dignità, riservatezza e miglioramento continuo.</span></li></ul><p class="clinical-direction"><strong>Direttore sanitario</strong><br />Dott. Elio Basso Narducci</p></div></section>
  <section class="section reviews" id="recensioni"><div><p class="eyebrow">Le esperienze dei pazienti</p><h2>La fiducia si costruisce<br />un passo alla volta.</h2><p>Leggi le esperienze condivise da chi ha scelto FisioSalute per il proprio percorso.</p></div><a class="button" href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x47838fff424efac1:0x985d407e41cfd44a" target="_blank" rel="noreferrer">Recensioni su Google</a></section>
  <section class="section faq" id="faq"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di iniziare.</h2><p>Qualche risposta utile per arrivare alla prima visita con serenità.</p></div><div class="faq-list">{faqs.map(([q,a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="contact" id="contatti"><div class="contact-inner"><p class="eyebrow light">Inizia da qui</p><h2>Raccontaci di cosa<br />hai bisogno.</h2><p>Non sai quale professionista o trattamento scegliere? Scrivici: ti aiuteremo a individuare il primo passo più adatto.</p><form id="contact-form"><label>Nome e cognome<input name="name" autocomplete="name" required /></label><label>E-mail<input type="email" name="email" autocomplete="email" required /></label><label class="full">Area di interesse<select name="interest"><option>Fisioterapia e riabilitazione</option><option>Visita specialistica</option><option>Nutrizione</option><option>Alimentazione</option><option>Non so, vorrei un consiglio</option></select></label><label class="full">Messaggio<textarea name="message" rows="4" required></textarea></label><div class="form-footer"><small>La richiesta apre il tuo programma e-mail e non trasmette dati al sito.</small><button class="button button-sand" type="submit">Prepara l’e-mail</button></div></form><div class="hero-actions"><a class="text-link light" href="/dove-siamo">Dove siamo <span>→</span></a><a class="text-link light" href="mailto:info@fisiosalute.it">info@fisiosalute.it <span>↗</span></a></div></div></section>
  <Footer />
</main><script>document.getElementById("contact-form")?.addEventListener("submit",(event)=>{event.preventDefault();const data=new FormData(event.currentTarget as HTMLFormElement);const subject=encodeURIComponent(`Richiesta dal sito — ${data.get("interest")}`);const body=encodeURIComponent(`Nome: ${data.get("name")}\nE-mail: ${data.get("email")}\nInteresse: ${data.get("interest")}\n\n${data.get("message")}`);window.location.href=`mailto:info@fisiosalute.it?subject=${subject}&body=${body}`;});</script></BaseLayout>
