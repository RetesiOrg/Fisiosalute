---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const services = [
  ["fisioterapia", "Fisioterapia", "Valutazione e trattamento personalizzato per dolore, rigidità e recupero della mobilità."],
  ["terapia-manuale", "Terapia manuale", "Tecniche mirate per ridurre tensioni, migliorare il movimento e ritrovare benessere."],
  ["riabilitazione", "Riabilitazione", "Percorsi graduali dopo traumi, interventi chirurgici o periodi di inattività."],
  ["postura", "Rieducazione posturale", "Lavoro attivo su postura, consapevolezza e strategie utili nella vita quotidiana."],
  ["prevenzione", "Prevenzione", "Esercizio terapeutico e indicazioni pratiche per mantenere i risultati nel tempo."],
  ["domicilio", "Trattamenti a domicilio", "Assistenza fisioterapica a casa per chi ha difficoltà a raggiungere lo studio."],
];
const faqs = [
  ["Come si svolge la prima visita?", "La prima seduta è dedicata all’ascolto, alla valutazione del movimento e alla definizione condivisa degli obiettivi. Da qui nasce un percorso realmente personale."],
  ["Quanto dura una seduta?", "La durata dipende dal tipo di trattamento e dalle esigenze della persona. Verrà indicata con chiarezza al momento della prenotazione."],
  ["Serve una prescrizione medica?", "Non sempre. In presenza di diagnosi, esami o indicazioni specialistiche è comunque utile portarli alla prima visita."],
  ["È possibile richiedere una visita a domicilio?", "Sì, in base alla zona e alla disponibilità. Indicalo nella richiesta di appuntamento."],
];
const studioHighlights = [
  ["erika-voltan.png", "Erika Voltan", "Fisioterapista e referente del percorso", "/erika-voltan"],
  ["staff-fisiosalute.png", "Lo staff", "Competenze che lavorano insieme", "/staff"],
  ["collaborazioni-fisiosalute.png", "Collaborazioni", "Una rete attenta alle tue esigenze", null],
  ["laserterapia.jpeg", "Tecnologie", "Strumenti scelti quando davvero utili", null],
];
---
<BaseLayout><main><Header />
  <section class="hero" id="inizio"><picture class="hero-media"><source media="(max-width: 900px)" srcset="/images/studio-fisiosalute-mobile.webp" /><img src="/images/studio-fisiosalute.webp" alt="Palestra riabilitativa dello studio FisioSalute" width="1920" height="900" fetchpriority="high" /></picture><div class="hero-overlay"></div><div class="hero-content"><p class="eyebrow light">Fisioterapia • Riabilitazione • Benessere</p><h1>Ritrova il piacere<br />di muoverti.</h1><p class="hero-copy">Un percorso fisioterapico costruito intorno a te, per comprendere il dolore, recuperare fiducia e tornare alle attività che ami.</p><div class="hero-actions"><a class="button button-sand" href="#contatti">Prenota una valutazione</a><a class="text-link light" href="#servizi">Scopri i trattamenti <span>↓</span></a></div></div><div class="hero-note"><strong>FisioSalute</strong><span>di Erika Voltan</span><span>Riceve su appuntamento</span></div></section>
  <section class="trust-strip" aria-label="Valori dello studio"><div><span>01</span><p><strong>Ascolto</strong>Prima di tutto, la tua storia.</p></div><div><span>02</span><p><strong>Competenza</strong>Un percorso basato sulla valutazione.</p></div><div><span>03</span><p><strong>Continuità</strong>Obiettivi chiari, passo dopo passo.</p></div></section>
  <section class="section services" id="servizi"><div class="section-heading"><div><p class="eyebrow">Come posso aiutarti</p><h2>Trattamenti pensati<br />per la tua salute.</h2></div><p>Ogni persona si muove in modo diverso. Per questo il trattamento parte da una valutazione accurata e si adatta nel tempo ai tuoi progressi.</p></div><div class="service-grid">{services.map(([icon,title,copy], i) => <article class="service-card"><span class="service-number">0{i+1}</span><img src={`/icons/${icon}.png`} alt="" width="54" height="54" loading="lazy" /><h3>{title}</h3><p>{copy}</p><a href="#contatti">Richiedi informazioni <span>↗</span></a></article>)}</div></section>
  <section class="approach" id="approccio"><div class="approach-image"><img src="/images/valutazione.webp" alt="Valutazione fisioterapica del movimento" loading="lazy" /></div><div class="approach-copy"><p class="eyebrow light">Il metodo FisioSalute</p><h2>Non solo trattare.<br />Capire, accompagnare,<br />prevenire.</h2><p>Il dolore non è mai soltanto un punto da trattare. Insieme osserviamo il movimento, le abitudini e ciò che conta davvero per te, così il percorso diventa concreto e sostenibile.</p><ol><li><span>01</span><div><strong>Valutiamo</strong><p>Ascolto, test e obiettivi condivisi.</p></div></li><li><span>02</span><div><strong>Trattiamo</strong><p>Terapia manuale ed esercizio su misura.</p></div></li><li><span>03</span><div><strong>Consolidiamo</strong><p>Strategie per mantenere i risultati.</p></div></li></ol></div></section>
  <section class="section about" id="studio"><div class="about-copy"><p class="eyebrow">La professionista</p><h2>Erika Voltan,<br />fisioterapista.</h2><p class="lead">Un approccio attento, chiaro e vicino alla persona.</p><p>Credo in una fisioterapia che renda la persona parte attiva del proprio recupero. Ogni percorso nasce dall’ascolto e unisce trattamento, movimento ed educazione, con spiegazioni semplici e obiettivi realistici.</p><blockquote>“Il mio obiettivo non è soltanto farti stare meglio oggi, ma darti gli strumenti per muoverti con più fiducia domani.”</blockquote><a class="text-link" href="/erika-voltan">Conosci Erika e il suo percorso <span>→</span></a></div><div class="about-gallery"><div class="photo photo-main"><img src="/images/riabilitazione.webp" alt="Esercizio riabilitativo personalizzato" width="800" height="800" loading="lazy" decoding="async" /></div><div class="photo photo-small photo-portrait"><img src="/images/erika-voltan.png" alt="Erika Voltan, fisioterapista" width="140" height="140" decoding="async" /></div><div class="quality-stamp"><span>Fisio</span><strong>Salute</strong><small>movimento & benessere</small></div></div></section>
  <section class="studio-highlights" aria-labelledby="studio-highlights-title"><div class="studio-highlights-heading"><p class="eyebrow light">Persone, spazio, competenze</p><h2 id="studio-highlights-title">Dentro FisioSalute.</h2><p>Un ambiente attrezzato e una rete di professionalità per costruire percorsi concreti, dalla valutazione al ritorno al movimento.</p></div><div class="studio-highlights-grid">{studioHighlights.map(([image, title, copy, href]) => href ? <a class="studio-highlight-link" href={href} aria-label={`Scopri di più su ${title}`}><img src={`/images/${image}`} alt="" width="140" height="140" decoding="async" /><div><h3>{title}</h3><p>{copy}</p></div><span aria-hidden="true">→</span></a> : <article><img src={`/images/${image}`} alt={title} width="140" height="140" decoding="async" /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></section>
  <section class="section faq" id="faq"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di iniziare.</h2><p>Qualche risposta utile per arrivare alla prima visita con serenità.</p></div><div class="faq-list">{faqs.map(([q,a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="contact" id="contatti"><div class="contact-inner"><p class="eyebrow light">Inizia da qui</p><h2>Facciamo il primo passo<br />verso il tuo benessere.</h2><p>Contatta Erika per raccontare brevemente la tua esigenza e concordare un appuntamento.</p><div class="hero-actions"><a class="button button-sand" href="/dove-siamo">Dove siamo</a><a class="text-link light" href="mailto:info@fisiosalute.it">Scrivi una e-mail <span>↗</span></a></div></div></section>
  <Footer />
</main></BaseLayout>
