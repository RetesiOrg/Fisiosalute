---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { instagramProfileUrl, latestInstagramPosts } from "../data/news";

const posts = latestInstagramPosts.slice(0, 2);
---

<BaseLayout
  title="News | FisioSalute"
  description="Le ultime notizie, attività e informazioni pubblicate da FisioSalute sul profilo Instagram ufficiale."
>
  <Header /><main id="main-content" tabindex="-1">

    <section class="news-hero">
      <p class="eyebrow light">News e aggiornamenti</p>
      <h1>Le ultime da<br />FisioSalute.</h1>
      <p>Attività, consigli e novità dal centro attraverso il nostro profilo Instagram ufficiale.</p>
    </section>

    <section class="instagram-news" aria-labelledby="instagram-news-title">
      <header>
        <p class="eyebrow">Dal nostro profilo</p>
        <h2 id="instagram-news-title">Ultime novità</h2>
      </header>

      <div class="instagram-feed" data-instagram-feed>
        {posts.map((post) => (
          <article class="instagram-post">
            {post.image ? <ResponsiveImage src={post.image} alt={post.title} loading="lazy" /> : <div class="instagram-post-placeholder" aria-hidden="true">FisioSalute</div>}
            <div class="instagram-post-content">
              <time datetime={post.date || undefined} aria-hidden={!post.date}>{post.dateLabel}</time>
              <h3>{post.title}</h3>
              <a class="text-link" href={post.url} target="_blank" rel="noreferrer">Leggi il post su Instagram <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>

      <div class="instagram-news-footer">
        <p>Vuoi vedere tutti i contenuti e seguire FisioSalute?</p>
        <a class="button" href={instagramProfileUrl} target="_blank" rel="noreferrer">
          Vai al profilo Instagram ↗
        </a>
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>

<style>
  /* Keep the original Instagram artwork and its text fully visible. */
  :global(.instagram-feed .instagram-post > img) {
    flex: none;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    background: #fff;
  }
  :global(.instagram-feed .instagram-post-content) {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  :global(.instagram-feed .instagram-post-content > time) {
    min-height: 1.4em;
  }
  :global(.instagram-feed .instagram-post-content > .text-link) {
    align-self: flex-start;
    margin-top: auto;
  }
</style>

<script>
  import { validateInstagramFeed } from "../data/instagram-feed.mjs";
  async function updateInstagramNews() {
    const container = document.querySelector<HTMLElement>('[data-instagram-feed]');
    if (!container) return;
    const base = new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/"), location.origin);
    try {
      const response = await fetch(new URL('api/instagram.json', base), { signal: AbortSignal.timeout(10000) });
      if (!response.ok) return;
      const posts = validateInstagramFeed(await response.json());
      if (!posts) return;
      const cards = await Promise.all(posts.map(async (post: {image: string; title: string; date: string | null; url: string}) => {
        const article = document.createElement('article');
        article.className = 'instagram-post';
        const image = new Image();
        image.src = new URL(post.image, base).href;
        image.alt = post.title;
        image.decoding = 'async';
        await image.decode();
        image.width = image.naturalWidth;
        image.height = image.naturalHeight;
        const content = document.createElement('div');
        content.className = 'instagram-post-content';
        const date = document.createElement('time');
        if (post.date) {
        date.dateTime = post.date;
        date.textContent = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' }).format(new Date(post.date));
        } else { date.setAttribute("aria-hidden", "true"); }
        const title = document.createElement('h3');
        title.textContent = post.title;
        const link = document.createElement('a');
        link.className = 'text-link';
        link.href = post.url;
        link.target = '_blank';
        link.rel = 'noreferrer';
        link.textContent = 'Leggi il post su Instagram ↗';
        content.append(date, title, link);
        article.append(image, content);
        return article;
      }));
      container.replaceChildren(...cards);
    } catch { /* Keep the complete static feed if an update or image fails. */ }
  }
  void updateInstagramNews();
</script>
