---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { serviceAreas } from "../../../data/services";
import { medicalSpecialists } from "../../../data/medical-specialists";
export function getStaticPaths() { return serviceAreas.map((area) => ({ params: { area: area.slug }, props: { area } })); }
const { area } = Astro.props;
const areaHref = `/servizi/area/${area.slug}/`;
const serviceHrefs = new Set(area.services.map(service => `/servizi/${service.slug}/`));
const areaSpecialists = medicalSpecialists.filter(specialist =>
  specialist.serviceLinks.some(link => link.href === areaHref ||
    (area.slug !== "fisioterapia-riabilitazione" && serviceHrefs.has(link.href)))
);
---
<BaseLayout title={`${area.title} | FisioSalute`} description={area.lead}><Header /><main id="main-content" tabindex="-1">
  <section class="area-hero"><div><a href="/servizi/">← Tutti i servizi</a><p class="eyebrow light">Area {area.number}</p><h1>{area.title}</h1><p>{area.lead}</p></div><span aria-hidden="true">{area.number}</span></section>
  {areaSpecialists.length > 0 && <section class="service-specialists"><div><p class="eyebrow">Équipe medica</p><h2>Chi si occupa di quest’area</h2></div><div class="specialist-list">{areaSpecialists.map(person => <a href={person.href}><span>{person.name}</span><small>{person.role}</small><i aria-hidden="true">→</i></a>)}</div></section>}
  {area.paragraphs?.length && <article class="area-description">
    {area.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    {area.sections?.map(section => <section>
      <h2>{section.title}</h2>
      {section.items?.length && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
      {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
    </section>)}
    {area.slug === "urologia" && <a class="text-link" href="/servizi/pavimento-pelvico/">Scopri la riabilitazione del pavimento pelvico →</a>}
  </article>}
  <section class="area-services"><header><p class="eyebrow">Prestazioni</p><h2>Servizi dell’area</h2><p>Seleziona un servizio per approfondire obiettivi, indicazioni e modalità del percorso.</p></header><div>{area.services.map((service, index) => <a href={`/servizi/${service.slug}/`}><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{service.title}</h3><p>{service.summary}</p><strong>Scopri il servizio →</strong></div></a>)}</div></section>
  <section class="staff-cta"><div><p class="eyebrow light">Orientamento</p><h2>Partiamo dalla tua esigenza.</h2></div><div><p>Contattaci per capire quale servizio dell’area è più indicato.</p><a class="button button-sand" href="/#contatti">Richiedi informazioni</a></div></section><Footer />
</main></BaseLayout>

<style>
  .area-description { padding: 80px clamp(24px, 8vw, 128px) 0; background: #fff; color: #596660; }
  .area-description > p, .area-description section { max-width: 960px; }
  .area-description h2 { margin: 36px 0 18px; color: var(--deep); font-size: clamp(28px, 3vw, 40px); line-height: 1.15; }
  .area-description ul { padding-left: 24px; }
  .area-description li { margin-bottom: 12px; }
  .area-description a { display: inline-block; margin-top: 12px; color: var(--petrol); font-weight: 700; }
  @media (max-width: 900px) { .area-description { padding: 60px 24px 0; } }
</style>
