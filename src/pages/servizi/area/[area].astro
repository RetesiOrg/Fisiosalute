---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { serviceAreas } from "../../../data/services";
import { medicalSpecialists } from "../../../data/medical-specialists";
export function getStaticPaths() { return serviceAreas.map((area) => ({ params: { area: area.slug }, props: { area } })); }
const { area } = Astro.props;
const pageTitle = area.seo?.title ?? `${area.title} a Sondrio, Valtellina | FisioSalute`;
const pageDescription = area.seo?.description ?? `${area.title} presso FisioSalute a Sondrio, in Valtellina. ${area.lead}`;
const heading = area.seo?.heading ?? area.title;
const breadcrumbs = [
  { name: "Servizi", path: "/servizi/" },
  { name: area.title, path: `/servizi/area/${area.slug}/` },
];
const areaHref = `/servizi/area/${area.slug}/`;
const serviceHrefs = new Set(area.services.map(service => `/servizi/${service.slug}/`));
const areaSpecialists = area.specialists ?? medicalSpecialists.filter(specialist =>
  specialist.serviceLinks.some(link => link.href === areaHref ||
    (area.slug !== "fisioterapia-riabilitazione" && serviceHrefs.has(link.href)))
);
---
<BaseLayout breadcrumbs={breadcrumbs} title={pageTitle} description={pageDescription}><Header /><main id="main-content" tabindex="-1">
  <section class:list={["area-hero", { "area-hero-local": Boolean(area.seo) }]}><div><nav aria-label="Percorso di navigazione"><a href="/servizi/">← Tutti i servizi</a><span class="visually-hidden" aria-current="page">{area.title}</span></nav><p class="eyebrow light">Area {area.number}</p><h1 id="area-title">{heading}</h1><p>{area.lead}</p></div><span aria-hidden="true">{area.number}</span></section>
  {areaSpecialists.length > 0 && <section class="service-specialists"><div><p class="eyebrow">{area.specialists ? "Professionisti" : "Équipe medica"}</p><h2>Chi si occupa di quest’area</h2></div><div class="specialist-list">{areaSpecialists.map(person => <a href={person.href}><span>{person.name}</span><small>{person.role}</small><i aria-hidden="true">→</i></a>)}</div></section>}
  {area.paragraphs?.length && <article class="area-description" aria-labelledby="area-title">
    {area.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    {area.sections?.map(section => <section>
      <h2>{section.title}</h2>
      {section.items?.length && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
      {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
    </section>)}
    {area.slug === "otorinolaringoiatria" && <a class="text-link" href="/contatti/">Contatti e indicazioni per raggiungerci →</a>}
    {area.slug === "urologia" && <a class="text-link" href="/servizi/pavimento-pelvico/">Scopri la riabilitazione del pavimento pelvico →</a>}
  </article>}
  <section class="area-services"><header><p class="eyebrow">Prestazioni</p><h2>Servizi dell’area</h2><p>Seleziona un servizio per approfondire obiettivi, indicazioni e modalità del percorso.</p></header><div>{area.services.map((service, index) => <a href={`/servizi/${service.slug}/`}><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{service.title}</h3><p>{service.summary}</p><strong>Scopri il servizio →</strong></div></a>)}</div></section>
  <section class="staff-cta"><div><p class="eyebrow light">Orientamento</p><h2>Partiamo dalla tua esigenza.</h2></div><div><p>Contattaci per capire quale servizio dell’area è più indicato.</p><a class="button button-sand" href="/#contatti">Richiedi informazioni</a></div></section></main><Footer /></BaseLayout>

<style>
  .area-description { padding: 80px clamp(24px, 8vw, 128px) 0; background: #fff; color: #596660; }
  .area-description > p, .area-description section { max-width: 960px; }
  .area-description h2 { margin: 36px 0 18px; color: var(--deep); font-size: clamp(28px, 3vw, 40px); line-height: 1.15; }
  .area-description ul { padding-left: 24px; }
  .area-description li { margin-bottom: 12px; }
  .area-description a { display: inline-block; margin-top: 12px; color: var(--petrol); font-weight: 700; }
  @media (max-width: 900px) { .area-description { padding: 60px 24px 0; } }
  @media(max-width:520px){.area-hero-local h1{font-size:clamp(24px,7.6vw,40px);overflow-wrap:anywhere}}
</style>
