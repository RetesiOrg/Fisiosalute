---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const profiles = [
  {
    id: "silvia-simonini",
    name: "Silvia Simonini",
    role: "Fisioterapista",
    image: "/images/STAF_Silvia.png",
    imageWidth: 1254,
    imageHeight: 1254,
    intro: "La Dott.ssa Silvia Simonini si è laureata in Fisioterapia nel 2023 presso l’Università degli Studi di Milano-Bicocca.",
    paragraphs: [
      "Nel corso degli studi ha maturato una significativa esperienza pratica presso strutture pubbliche e private, tra cui l’Ospedale Papa Giovanni XXIII di Bergamo e le cliniche dei gruppi Humanitas e Habilita.",
      "Ha continuato a perfezionarsi nella riabilitazione sportiva, nella gestione della lombalgia, nelle patologie neurologiche secondo il metodo Bobath, nella ginnastica posturale e nell’utilizzo del Pilates Reformer.",
      "Dal gennaio 2024 fa parte dello staff di FisioSalute, dove collabora in stretta sinergia con la Dott.ssa Erika Voltan.",
    ],
    skills: ["Riabilitazione sportiva", "Bendaggio e kinesiotaping", "Metodo Bobath", "Pilates Reformer"],
  },
  {
    id: "alessandra-cao",
    name: "Alessandra Cao",
    role: "Fisioterapista",
    image: "/images/STAF_Alessandra.png",
    imageWidth: 1254,
    imageHeight: 1254,
    intro: "La Dott.ssa Alessandra Cao si è laureata in Fisioterapia nel 2024 presso l’Università degli Studi di Milano.",
    paragraphs: ["Durante gli studi ha svolto tirocini presso l’Ospedale San Paolo, il Centro specialistico ortopedico-traumatologico Gaetano Pini e gli Istituti Clinici Scientifici Maugeri di Milano.", "Nel 2021 ha conseguito il titolo di massoterapista MCB presso Ecolife Milano."],
    skills: ["Patologie muscolo-scheletriche", "Riabilitazione pre e post chirurgica", "Massoterapia", "Riabilitazione neurologica e posturale"],
  },
  {
    id: "monica-colzada",
    name: "Monica Colzada",
    role: "Fisioterapista",
    image: "/images/STAF_Colzada.png",
    imageWidth: 1254,
    imageHeight: 1254,
    intro: "La Dott.ssa Monica Colzada si è laureata in Fisioterapia a Pavia nel 2017 e ha conseguito un Master in Terapia Manuale a Bologna.",
    paragraphs: ["Ha sempre avuto la passione per il movimento e l’attività fisica. Crede nell’esercizio terapeutico come forma di prevenzione e riabilitazione del dolore.", "Nel suo lavoro unisce professionalità e umanità per garantire al paziente una terapia mirata ed efficace, costruita sui suoi obiettivi."],
    skills: ["Terapia manuale ed esercizio terapeutico", "Riabilitazione ortopedica e post chirurgica", "Dolori muscolo-scheletrici", "Percorsi riabilitativi personalizzati"],
  },
  {
    id: "benedetta-nicolussi",
    name: "Benedetta Nicolussi",
    role: "Fisioterapista",
    image: null,
    intro: "Il profilo di Benedetta Nicolussi sarà completato con la nuova fotografia e le informazioni professionali.",
    paragraphs: [],
    skills: [],
  },
  {
    id: "maria-mereghetti",
    name: "Maria Mereghetti",
    role: "Fisioterapista linfologa",
    image: "/images/STAF_Mereghetti.png",
    imageWidth: 1254,
    imageHeight: 1254,
    intro: "La Dott.ssa Maria Mereghetti è fisioterapista linfologa e fa parte dell’équipe FisioSalute.",
    paragraphs: ["Si occupa di linfodrenaggio manuale terapeutico, trattamento di linfedema e lipedema e riabilitazione post-operatoria e post-chirurgica.", "Completa la sua attività con bendaggio terapeutico elastocompressivo, rieducazione posturale globale, Pilates clinico a terra e con Reformer."],
    skills: ["Linfodrenaggio manuale terapeutico", "Linfedema e lipedema", "Bendaggio elastocompressivo", "Pilates clinico e Reformer"],
  },
];
---

<BaseLayout title="Staff | FisioSalute di Erika Voltan" description="Conosci lo staff di FisioSalute: fisioterapiste con competenze complementari per percorsi riabilitativi personalizzati a Sondrio.">
  <main>
    <Header />
    <section class="staff-hero">
      <div class="staff-hero-copy">
        <p class="eyebrow light">FisioSalute · Sondrio</p>
        <h1>Persone che si prendono cura del tuo movimento.</h1>
        <p>Un team di professioniste con competenze complementari, unito dallo stesso modo di lavorare: ascolto, chiarezza e percorsi costruiti davvero intorno alla persona.</p>
        <a class="button button-sand" href="/#contatti">Richiedi un appuntamento</a>
      </div>
      <div class="staff-hero-image">
        <span aria-hidden="true">Il team</span>
        <img src="/images/staff-team-group.webp" alt="Il team FisioSalute: Maria Mereghetti, Erika Voltan, Monica Colzada, Alessandra Cao e Silvia Simonini" width="500" height="625" fetchpriority="high" />
        <small>Da sinistra in alto: Maria Mereghetti, Erika Voltan e Monica Colzada. In primo piano: Alessandra Cao e Silvia Simonini.</small>
      </div>
    </section>

    <section class="staff-intro" aria-labelledby="staff-title">
      <div>
        <p class="eyebrow">Il nostro staff</p>
        <h2 id="staff-title">Professionalità diverse,<br />una visione condivisa.</h2>
      </div>
      <p>Ogni professionista porta formazione, esperienza e sensibilità specifiche. Il confronto continuo permette di scegliere l’approccio più adatto e accompagnare ogni persona con attenzione, dal primo incontro al ritorno alle attività quotidiane.</p>
    </section>

    <section class="staff-profiles" aria-label="Profili professionali">
      {profiles.map((profile, index) => (
        <article class:list={["staff-profile", { reverse: index % 2 === 1 }]} id={profile.id}>
          <div class="staff-profile-image">
            {profile.image ? <img src={profile.image} alt={`${profile.name}, ${profile.role}`} width={profile.imageWidth} height={profile.imageHeight} loading="lazy" decoding="async" /> : <div class="staff-profile-image-placeholder">Foto in arrivo</div>}
            <span>0{index + 1}</span>
          </div>
          <div class="staff-profile-copy">
            <p class="eyebrow">{profile.role}</p>
            <h2>{profile.name}</h2>
            <p class="staff-lead">{profile.intro}</p>
            {profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <ul aria-label={`Competenze di ${profile.name}`}>
              {profile.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>

    <section class="staff-cta">
      <div>
        <p class="eyebrow light">Inizia da qui</p>
        <h2>Troviamo insieme il percorso più adatto a te.</h2>
      </div>
      <div>
        <p>Raccontaci brevemente la tua esigenza: ti aiuteremo a individuare la professionista e il percorso più indicati.</p>
        <a class="button button-sand" href="/#contatti">Contatta FisioSalute</a>
      </div>
    </section>
    <Footer />
  </main>
</BaseLayout>

<style>
  .staff-hero-image small {
    position: absolute;
    z-index: 2;
    left: 30px;
    right: 30px;
    bottom: 24px;
    padding: 10px 12px;
    color: var(--deep);
    background: rgba(247, 244, 238, .9);
    font-size: 11px;
    line-height: 1.4;
  }

  .staff-profile-image-placeholder {
    display: grid;
    place-items: center;
    min-height: 460px;
    color: var(--petrol);
    background: var(--sand);
    font-weight: 700;
  }

  #emanuela-giordani .staff-profile-image img {
    transform: scale(1.1);
    transform-origin: center top;
  }
</style>
